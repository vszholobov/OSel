# Bilingual documentation project settings
langs: ['ru', 'en']
allowHtml: false
lint: true
# custom styles of the site, docs/_assets/style/custom.css
allowCustomResources: true
resources:
  style:
    - _assets/style/custom.css
interface:
  # the png is not linked from any page, so it is taken straight from the repository
  favicon-src: https://raw.githubusercontent.com/vszholobov/OSel/master/docs/images/osel-favicon.png
  # the site name is already in the top menu, the table of contents doesn't repeat it
  toc-header: false
search:
  provider: local
llms:
  enabled: true
  description: >-
    OSel is an educational Rust operating system for x86_64. Russian and English
    documentation covers running images, kernel development, architecture, decisions and plans.

docs-viewer:
  lang: ru
  langs: [ru, en]
